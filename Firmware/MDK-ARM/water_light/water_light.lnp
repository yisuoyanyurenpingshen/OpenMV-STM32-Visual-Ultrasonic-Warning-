--cpu Cortex-M3
"water_light\startup_stm32f103xb.o"
"water_light\main.o"
"water_light\gpio.o"
"water_light\i2c.o"
"water_light\stm32f1xx_it.o"
"water_light\stm32f1xx_hal_msp.o"
"water_light\oled.o"
"water_light\oledfont.o"
"water_light\hc_sr04.o"
"water_light\stm32f1xx_hal_gpio_ex.o"
"water_light\stm32f1xx_hal_i2c.o"
"water_light\stm32f1xx_hal.o"
"water_light\stm32f1xx_hal_rcc.o"
"water_light\stm32f1xx_hal_rcc_ex.o"
"water_light\stm32f1xx_hal_gpio.o"
"water_light\stm32f1xx_hal_dma.o"
"water_light\stm32f1xx_hal_cortex.o"
"water_light\stm32f1xx_hal_pwr.o"
"water_light\stm32f1xx_hal_flash.o"
"water_light\stm32f1xx_hal_flash_ex.o"
"water_light\stm32f1xx_hal_exti.o"
"water_light\stm32f1xx_hal_tim.o"
"water_light\stm32f1xx_hal_tim_ex.o"
"water_light\system_stm32f1xx.o"
--strict --scatter "water_light\water_light.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "water_light.map" -o water_light\water_light.axf